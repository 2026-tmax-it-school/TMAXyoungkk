# 동기화·중계 서버 설정. 이 파일을 server/.env 로 복사해서 쓴다(npm run server가 읽는다). 앱 번들에는 들어가지 않는다.

# PostgreSQL 주소. 비우면 메모리 저장이다(서버를 끄면 사라진다).
# 값이 있는데 붙지 못하면 서버가 시작하지 않는다(메모리로 바꾸지 않는다). 아래 값은 server/docker-compose.yml의 개발용 계정이다.
# 로컬 DB: npm run db:up 으로 켠 뒤 npm run server. DB 없이 중계(카카오·길)만 확인하려면 이 값을 비운다.
DATABASE_URL=postgresql://youngtrip:youngtrip-dev@127.0.0.1:5432/youngtrip

# 서버 포트. 앱 .env의 EXPO_PUBLIC_SYNC_URL·EXPO_PUBLIC_API_URL=http://<이 컴퓨터 IP>:8787 과 맞춘다.
PORT=8787

# 시연 리셋(POST /reset, 앱 더보기의 시연 리셋)이 서버의 여행방을 모두 지우게 할지. PostgreSQL 모드에서만 본다.
# 비우거나 0이면 막는다(403. 앱은 이 기기만 비운다). 1이면 같은 DB를 쓰는 모든 사람의 여행방이 지워지므로 혼자 쓰는 DB에서만 켠다.
# 메모리 모드는 이 값과 상관없이 늘 지운다.
SYNC_ALLOW_RESET=

# 카카오 REST 키. 서버에만 둔다(앱 .env에 넣지 않는다). 있으면 앱(EXPO_PUBLIC_API_URL)이 키 없이 이 서버를 거쳐
# 카카오 로컬 장소 검색과 카카오모빌리티 자동차 길찾기를 쓴다. 서버가 Authorization: KakaoAK 헤더를 붙인다.
# 비우면 카카오 중계(/kakao/…)는 503이고 앱은 로컬 장소 사전·추정 경로로 넘어간다. 프로토타입 가정 · 국내 SDK 선정 미결정.
# 키가 틀렸거나 카카오 개발자 콘솔에서 카카오맵(로컬)·카카오모빌리티 사용 설정을 하지 않으면 카카오가 401·403을 준다.
# 중계는 그 상태를 그대로 넘기고 서버 로그에 한 번 적는다(앱은 서버 경유 실패를 로컬 대체로 넘긴다).
# 확인: 시작 로그의 '중계: 카카오 켜짐', curl 'http://127.0.0.1:8787/kakao/local/keyword?query=%EB%B6%88%EA%B5%AD%EC%82%AC'
KAKAO_REST_KEY=

# 길 서버(OSRM). 앱의 도로 모양(/osrm/…)을 여기에 대신 묻고 24시간 캐시한다.
# 비우면 공개 서버 https://routing.openstreetmap.de(FOSSGIS, 키 불필요, 가벼운 사용만)다.
# 같은 경로 꼴(routed-foot/route/v1/foot/…, routed-car/route/v1/driving/…)을 주는 서버여야 한다.
OSRM_URL=

# OSRM에 동시에 보내는 요청 수(기본 2). 공개 서버에는 이 값과 상관없이 2개까지만 보낸다(사용 정책).
# 차례를 6초 넘게 기다리거나 기다리는 요청이 100개를 넘으면 503 busy다(앱은 직선으로 두고 다음에 다시 묻는다).
OSRM_CONCURRENCY=

# 중계(/kakao/…, /osrm/…)의 IP별 1분 요청 수 상한(기본 300). 넘으면 429다. 0이면 끈다.
# IP는 연결한 주소다. 역방향 프록시 뒤에 두면 모든 요청이 한 IP로 세어진다.
PROXY_RATE_PER_MIN=

# 계정 서버의 개발용 보낸편지함(GET /auth/outbox)과 모의 소셜 로그인(/auth/social…). 1이면 연다.
# 앱 모의 메일함이 인증·재설정·소셜 연결 확인 메일을 보여 준다. SYNC_ALLOW_RESET=1이어도 열린다. 메모리 모드라고 저절로 열리지 않는다.
# 끄면 둘 다 404다(가입은 되지만 메일을 볼 수 없어 인증을 마칠 수 없다).
# 아무나 남의 인증·재설정 토큰을 읽을 수 있으므로 공유 서버·LAN에 연 서버에서는 켜지 않는다. 실제 메일 발송(SMTP)은 아직 없다.
AUTH_DEV_OUTBOX=

# 실제 소셜 로그인(구글·카카오 OAuth). 앱이 보낸 인가 코드를 이 서버가 제공자와 바꾸고 신원을 확인한다(POST /auth/oauth/…).
# 키가 없는 제공자는 503이고 앱은 키가 없다고 알린다. 값은 로그에 찍지 않는다(시작 로그에는 켜짐·꺼짐만). 만드는 법은 README 4-1절.
# 구글 OAuth 웹 클라이언트 ID와 보안 비밀번호. 둘 다 있어야 켜진다. ID는 앱 EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID와 같은 값.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 앱 개발 빌드의 안드로이드·iOS 구글 클라이언트 ID(쉼표, 선택). 이 ID로 온 코드는 secret 없이 바꾼다(설치형 앱 규칙).
GOOGLE_OAUTH_NATIVE_CLIENT_IDS=
# 카카오 REST API 키(= client_id, 앱 EXPO_PUBLIC_KAKAO_OAUTH_CLIENT_ID와 같은 값). 위 KAKAO_REST_KEY(장소·길찾기 중계)와 같은 키여도 된다.
KAKAO_OAUTH_CLIENT_ID=
# 카카오 로그인 보안 → Client Secret을 '사용함'으로 켰을 때만 넣는다. 켜 두고 비우면 카카오가 코드 교환을 거부한다(KOE010).
KAKAO_OAUTH_CLIENT_SECRET=
# 받는 돌아올 주소(쉼표). 제공자 콘솔에 등록한 주소와 글자까지 같아야 한다(끝 /만 무시). 비우면 http://localhost:8090 만 받는다.
# 목록 밖 주소로 온 요청은 400이다(가로챈 코드를 다른 주소로 바꿔 쓰는 것을 막는다). 배포·LAN 주소로 열면 여기와 콘솔에 더한다.
OAUTH_REDIRECT_URIS=

# 테스트를 실제 PostgreSQL로도 돌리려면 셸에서 넘긴다(없으면 PGlite만 돈다).
# 테스트는 임시 스키마를 만들어 쓰고 끝나면 지운다. 기존 표는 건드리지 않는다.
#   YT_TEST_DATABASE_URL=postgresql://youngtrip:youngtrip-dev@127.0.0.1:5432/youngtrip npm test
